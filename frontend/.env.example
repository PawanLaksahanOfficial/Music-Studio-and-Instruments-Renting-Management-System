# Base URL of the API. Leave unset to use "/api" (the Vite dev proxy, or the same origin in production).
# If the API is on another origin, it must be the same site (e.g. app.example.com -> api.example.com)
# and listed in the backend's CORS_ORIGINS, because the session cookie is SameSite=Strict.
# VITE_API_URL=https://api.example.com/api

# Optional: shows an "Explore the demo" button on the sign-in page that signs in to a
# read-only Demo account (create it in Staff Users with the role "Demo"). Leave unset to hide it.
# VITE_DEMO_USERNAME=demo
# VITE_DEMO_PASSWORD=Demo1234
