# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# A replica set is required (Atlas provides one) — the API uses transactions.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ─── Notifications: Azure Communication Services ───────────────────────────
# Leave AZURE_COMMUNICATION_CONNECTION_STRING empty to run with the console
# provider, which logs notifications instead of sending them (fine for dev).
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER_ADDRESS=DoNotReply@<your-verified-domain>.azurecomm.net
AZURE_SMS_FROM_NUMBER=

# ─── Scheduled jobs ────────────────────────────────────────────────────────
# Set false when reminders run from an external scheduler (Azure Function
# timer trigger) so multiple API instances do not each fire the job.
ENABLE_CRON=true
REMINDER_CRON=0 9 * * *
