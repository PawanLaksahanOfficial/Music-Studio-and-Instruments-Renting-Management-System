# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Express "trust proxy": number of proxy hops in front of the API (e.g. 1 behind Nginx / a load balancer)
TRUST_PROXY=false
# Max API requests per IP per 15 minutes
RATE_LIMIT_MAX=1000

# ── Database (MongoDB replica set required for transactions — Atlas works) ──
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/elvi?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Browser access ───────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
# Serve ../frontend/dist from this server (same-origin production deploy)
SERVE_CLIENT=false
CLIENT_DIST=../frontend/dist

# ── Business settings ────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Colombo
DEFAULT_COUNTRY_CODE=94
CRON_ENABLED=true

# ── AWS (SMS via SNS, email via SES) ─────────────────────────────────────
# Leave the keys empty to use the default AWS credential chain (IAM role, ~/.aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=

# ── Seeding (npm run seed) ───────────────────────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
